{
  "name": "scholaris-mcp",
  "version": "0.1.0",
  "description": "MCP Server — academic paper review and publication preparation tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "scholaris-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "web": "tsx packages/web/server.ts",
    "web:pro": "cross-env SCHOLARIS_LICENSE_KEY=local tsx packages/web/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^3.0.7",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.27.4": true,
    "esbuild@0.28.1": true
  }
}
